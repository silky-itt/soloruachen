{
  "manifest_version": 3,
  "name": "Solo Code — 1v1 LeetCode Duel",
  "version": "1.0.0",
  "description": "Kết nối LeetCode với nền tảng Solo Code 1v1 để so tài lập trình realtime cùng bạn bè.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Solo Code 1v1",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content/page-bridge.js",
        "content/content.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-bridge.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ]
}
